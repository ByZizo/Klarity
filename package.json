{
  "name": "klarity",
  "version": "1.0.5",
  "description": "A clean, private finance tracker with a built-in AI assistant to help you manage your money, cards, and bills.",
  "main": "electron/main.js",
  "scripts": {
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "dev": "npx concurrently -k -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client install && npm --prefix client run build",
    "desktop": "npm --prefix client run build && npx electron .",
    "start": "node server/index.js",
    "dist": "npm run build && npx electron-builder --win"
  },
  "build": {
    "appId": "com.klarity.finance",
    "productName": "Klarity",
    "publish": [
      {
        "provider": "github",
        "owner": "ByZizo",
        "repo": "Klarity"
      }
    ],
    "files": [
      "electron/**/*",
      "server/**/*",
      "client/dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  },
  "workspaces": [
    "client"
  ],
  "keywords": [
    "fintech",
    "family-finance",
    "ai-advisor",
    "bills",
    "plaid",
    "gemini"
  ],
  "author": "Ziyad Elmahi",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@supabase/supabase-js": "^2.118.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "duck-duck-scrape": "^2.2.7",
    "express": "^5.3.0",
    "node-llama-cpp": "^3.22.2",
    "plaid": "^28.0.0"
  },
  "devDependencies": {
    "electron": "^41.2.1",
    "electron-builder": "^26.18.0",
    "electron-updater": "^6.8.3",
    "vercel": "^65.2.0"
  }
}
